# Copy this file to .env before running Docker Compose.
# Replace both placeholder secrets before starting the application.
POSTGRES_DB=azatech_database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password

# Must contain at least 32 characters.
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_JWT_REFRESH_SECRET=
APP_TOKEN_EXPIRES_IN=1h
APP_REFRESH_TOKEN_EXPIRES_IN=7d
APP_BCRYPT_SALT_ROUNDS=12

FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:8080
