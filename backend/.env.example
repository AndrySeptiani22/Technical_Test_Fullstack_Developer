NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=1919
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Generate a random secret with at least 32 characters.
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_TOKEN_EXPIRES_IN=1h
APP_REFRESH_TOKEN_EXPIRES_IN=7d
APP_BCRYPT_SALT_ROUNDS=12

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=replace-with-your-local-password
DB_NAME=azatech_database
DB_SSL=false
DB_POOL_MAX=10

# Required only for npm run bootstrap:superuser
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=replace-with-a-strong-password
SUPERUSER_NAME=System Administrator
